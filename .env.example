# Copy to .env.local only if you want a live database.
# With every value left empty, the app serves fictional sample data.

# demo (default) or live. Preview deployments always use sample data.
# DATA_MODE=demo

# Required only when a database is configured.
# DASHBOARD_PASSWORD=

# Both are required together. Leave both empty for sample data.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Required for a live scan. The sample demo does not call these.
# SAM_GOV_API_KEY=
# XAI_API_KEY=

# Required for the scheduled scan route.
# CRON_SECRET=

# Optional limits for live scoring.
# XAI_MONTHLY_BUDGET_USD=10
# XAI_MAX_EVALUATIONS_PER_SCAN=15
# XAI_MAX_EVALUATIONS_PER_DAY=25

# Optional. Saves search criteria to a GitHub file when DATA_MODE=live.
# GITHUB_TOKEN=
# GITHUB_REPO=your-org/acme-grant-dashboard
# GITHUB_BRANCH=main

# Optional. Used only by npm run db:setup and npm run db:seed.
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
